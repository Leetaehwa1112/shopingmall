# ─── 서버 환경변수 템플릿 ─────────────────────────────────
# 이 파일을 `.env`로 복사 후 실제 값을 채워주세요.
# `.env`는 절대 git에 커밋하지 마세요 (.gitignore에 포함되어 있어야 함).

# ─── 필수 ─────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB 연결 — Atlas URL 우선 사용, 없으면 MONGO_URI(로컬) 폴백
MONGODB_ATLAS_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/shopingmall

# JWT 서명 키 — 운영에선 32자 이상 강력한 랜덤 문자열.
# 생성: openssl rand -base64 48
JWT_SECRET=replace-me-with-strong-random-string-min-32-chars

# ─── CORS 허용 도메인 (콤마 구분 multi 지원) ──────────────
# 개발: 프론트 dev 서버 / 운영: 실제 프론트 도메인
CLIENT_ORIGIN=http://localhost:3000

# ─── Cloudinary (이미지 업로드) ───────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── PortOne (결제) — 향후 결제 검증/환불 연동 시 사용 ───
PORTONE_API_SECRET=

# ─── KakaoPay (환불 자동화) ───────────────────────────────
# kakaopay 비즈 콘솔 → 가맹점 키 발급에서 받음.
# 비워두면 환불 시 PG 자동 취소가 안 되고 DB만 처리됨.
# 테스트용 CID = TC0ONETIME (default), 실서비스는 발급받은 가맹점 CID.
KAKAOPAY_SECRET_KEY=
KAKAOPAY_CID=TC0ONETIME
